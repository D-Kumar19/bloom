# Public site URL used in copied share links and Open Graph metadata.
# Optional canonical origin for server metadata (no path, query, or fragment).
# Browser share links always use the current deployment origin.
# When unset, server metadata uses VERCEL_URL or Bloom's current live URL.
# Replace this only after connecting an owned domain; bloom.app is not ours.
NEXT_PUBLIC_SITE_URL=https://bloom-delta-nine.vercel.app

# Bouquet counter persistence (required on Vercel; optional locally).
# Connect an Upstash Redis integration to the Vercel project and enable its
# credentials for Production (and Preview if required), then redeploy.
# Use ONE complete pair: KV_REST_API_URL + KV_REST_API_TOKEN, or the native
# UPSTASH_REDIS_REST_URL + UPSTASH_REDIS_REST_TOKEN integration names.
# Use a writable token, not a read-only token. Never prefix these with NEXT_PUBLIC_.
# Production will NOT fall back to a local file. Missing/unreachable Redis yields
# a 503 counter API and an unavailable statistic, not a fabricated zero or page crash.
# Local development only: missing credentials use data/bouquet-count.json,
# with serialized writes within a single dev server (not multi-process storage).
# KV_REST_API_URL=
# KV_REST_API_TOKEN=
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=

# Required for counter POST requests on Vercel: a random secret of at least
# 32 characters. Generate privately (for example: openssl rand -hex 32).
# Hashes the Vercel-provided IP for short-lived rate-limit keys; never public.
# Rotating it starts new quotas, but does not reset gift markers or the total.
# Outside Vercel, production counting refuses writes because no trusted
# client-IP integration is configured. Local development shares one quota.
# COUNTER_RATE_LIMIT_SECRET=
